// Bonus (Bước 5.3): Jenkinsfile kết hợp CI (Bài 7) + CD (Bài 8)
pipeline {
    agent any

    tools {
        maven 'M3'
    }

    environment {
        DOCKER_USER    = 'YOUR_DOCKER_USERNAME'
        DOCKER_IMAGE   = "${DOCKER_USER}/devops-lab8-app"
        DOCKER_TAG     = "${env.BUILD_NUMBER}"
        CONTAINER_NAME = 'lab8-cicd-production'
        APP_PORT       = '3002'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '📦 STEP 1/7: CHECKOUT SCM'
                checkout scm
            }
        }

        // ===== CI STAGES (Bài 7) =====
        stage('CI: Build') {
            steps {
                echo '🔨 CI STEP: MAVEN COMPILE'
                sh 'mvn clean compile'
            }
        }

        stage('CI: Test') {
            steps {
                echo '🧪 CI STEP: MAVEN TEST'
                sh 'mvn test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('CI: Package') {
            steps {
                echo '📦 CI STEP: MAVEN PACKAGE'
                sh 'mvn package -DskipTests'
            }
        }

        // ===== CD STAGES (Bài 8) =====
        stage('CD: Docker Build') {
            steps {
                echo '🐳 CD STEP: BUILD DOCKER IMAGE'
                sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} -t ${DOCKER_IMAGE}:latest ."
            }
        }

        stage('CD: Push') {
            steps {
                echo '📤 CD STEP: PUSH IMAGE TO DOCKER HUB'
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials_1', usernameVariable: 'HUB_USER', passwordVariable: 'HUB_PASS')]) {
                    sh '''
                        echo "$HUB_PASS" | docker login -u "$HUB_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }

        stage('CD: Deploy') {
            steps {
                echo '🚀 CD STEP: DEPLOY CONTAINER'
                sh '''
                    docker stop ${CONTAINER_NAME} 2>/dev/null || true
                    docker rm ${CONTAINER_NAME} 2>/dev/null || true
                    docker run -d --name ${CONTAINER_NAME} -p ${APP_PORT}:3000 --restart unless-stopped ${DOCKER_IMAGE}:${DOCKER_TAG}
                '''
            }
        }
    }

    post {
        success {
            echo "🎉 CI+CD PIPELINE SUCCESS — ${DOCKER_IMAGE}:${DOCKER_TAG}"
        }
        failure {
            echo "💥 CI+CD PIPELINE FAILED!"
        }
        always {
            deleteDir()
        }
    }
}
